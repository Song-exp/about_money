# === App ===
# development | production
# production 이면 아래 필수값(DEEPSEEK_API_KEY / ADMIN_TOKEN / PG DATABASE_URL /
# localhost 없는 CORS_ORIGINS)이 없을 때 부팅이 실패한다. 조용히 폴백해서
# 반쪽짜리로 서비스되는 것보다 안 켜지는 편이 낫다.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 프론트 오리진(쉼표 구분). 배포 시 실제 도메인만 남긴다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# /admin/* (크롤·재색인 트리거) 보호. 요청 헤더 X-Admin-Token 으로 보낸다.
# 운영에서는 반드시 채운다. 비우면 production 부팅 실패.
ADMIN_TOKEN=

# 메일 링크(이메일 인증·수신 거부) 서명 키. 32자 이상 임의 문자열.
# 운영에서 기본값이면 부팅이 실패한다. 바꾸면 이미 나간 링크는 무효가 된다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret
# 이메일 인증 링크 수명(시간)
EMAIL_VERIFY_TTL_HOURS=48

# === 로그인 세션 ===
SESSION_COOKIE_NAME=benefit_session
SESSION_TTL_DAYS=30
# HTTPS 전용 쿠키. 운영에서 false면 세션이 평문으로 오간다 → production 부팅 실패.
SESSION_COOKIE_SECURE=false
# lax면 다른 사이트발 POST에 쿠키가 실리지 않아 CSRF를 막는다.
# 프론트와 API가 같은 도메인이어야 한다(개발의 Vite 프록시와 동일한 구조).
# 도메인을 분리하려면 none + secure 로 바꾸고 CSRF 토큰을 따로 도입해야 한다.
SESSION_COOKIE_SAMESITE=lax
# scrypt 비용. 2**15=32768 ≈ 110ms. 올릴수록 안전하지만 로그인이 느려진다.
SCRYPT_N=32768
# 로그인·가입 시도 분당 상한(IP 기준). 무차별 대입 방어.
AUTH_RATE_LIMIT_PER_MIN=10

# === 커뮤니티 ===
# HOT / BEST 게시판 편입 기준(공감 수). 커뮤니티가 커지면 올린다.
COMMUNITY_HOT_LIKE_THRESHOLD=10
COMMUNITY_BEST_LIKE_THRESHOLD=50
# 내 글에 이만큼 신고가 쌓이면 등급을 한 단계 내린다. 0이면 강등 없음.
# 등급이 '많이 아꼈다'만 뜻하면 자랑 뱃지지만, 틀린 정보로 깎이면 신뢰 지표가 된다.
COMMUNITY_REPORT_DEMOTE_THRESHOLD=5

# === 끝난 혜택 제보 ===
# 이 수 이상 제보되면 지도에서 흐리게 표시하고 best_deal 추천에서 뺀다.
# 자동 비활성은 하지 않는다(오탭·경쟁 매장으로 정상 혜택이 사라진다).
STORE_OFFER_REPORT_THRESHOLD=3

# === 마감 리마인더 ===
# 매일 지정 시각(KST)에 D-N 공고를 메일로 보낸다. SMTP 미설정이면 로그로만 나간다.
DEADLINE_REMINDER_ENABLED=true
DEADLINE_REMINDER_HOUR=9
# 마감 며칠 전에 보낼지(쉼표 구분). '이하 전부'가 아니라 딱 그날에만 보낸다.
DEADLINE_REMINDER_DAYS=7,3,1

# === 비밀번호 재설정 ===
# 재설정 링크에 들어갈 프론트 주소. 메일에 그대로 실리므로 실제 접속 가능해야 한다.
# 운영에서 localhost가 남아 있으면 부팅 실패.
APP_BASE_URL=http://localhost:5173
# 링크 수명(분). 짧을수록 안전하지만 메일 확인이 늦으면 놓친다.
PASSWORD_RESET_TTL_MINUTES=30

# === SMTP (stdlib smtplib · 프로바이더 무관) ===
# 비우면 메일을 보내지 않고 링크를 로그로 출력한다(로컬 개발용).
# 운영에서 비어 있으면 부팅 실패.
# Gmail 앱 비밀번호 / 네이버 / AWS SES / Mailgun 모두 동일하게 동작한다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 587 포트는 STARTTLS, 465 포트는 처음부터 TLS(SSL) 이다.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# === Database (PostgreSQL + pgvector) ===
# 예: postgresql+psycopg://user:password@localhost:5432/scholarship
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scholarship

# === LLM (DeepSeek: OpenAI 호환) ===
# 키가 없으면 규칙기반 폴백으로 동작. 실제 키는 .env에만 넣는다(커밋 금지).
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek는 임베딩 API 미지원 → 로컬 해시 임베딩 폴백 사용
EMBEDDING_DIM=256
# 외부 LLM 호출 상한. 타임아웃이 없으면 uvicorn 워커가 붙잡혀 전체가 느려진다.
LLM_TIMEOUT_SEC=20
LLM_MAX_RETRIES=2
# /chat/* 분당 호출 상한(클라이언트 IP 기준). LLM 비용 폭주 방지. 0이면 비활성.
CHAT_RATE_LIMIT_PER_MIN=20
# 계정별 장학금 정보 대화 이어쓰기 보관 기간(마지막 대화 기준)
INFORMATION_SESSION_RETENTION_DAYS=30

# === File upload ===
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# === Crawling (일간 파이프라인) ===
CRAWL_RESPECT_ROBOTS=true
CRAWL_DEFAULT_DELAY_SEC=1.5
# 공식 본문·첨부 1개당 다운로드 최대 크기(MB). 초과는 실패로 기록.
CRAWL_MAX_DOCUMENT_MB=20
# 게시판 전체 목록 안전 상한. 상한 도달은 성공이 아니라 실패로 기록.
CRAWL_BOARD_MAX_PAGES=1000
# 실패 시 지수 증가 재시도. 상한 도달/파서 미지원은 운영 검토로 전환.
CRAWL_RETRY_BASE_SEC=300
CRAWL_RETRY_MAX_SEC=86400
CRAWL_RETRY_MAX_ATTEMPTS=5
CRAWL_MAX_ARCHIVE_MEMBERS=100
CRAWL_MAX_RELATED_LINKS=30
# 읽을 공식 재단/신청 사이트 호스트(쉼표 구분). 미등록 링크도 검토 대상으로 보존.
CRAWL_EXTERNAL_HOSTS=com.khu.ac.kr
# OCR 도구가 없거나 낮은 신뢰도이면 미확인 상태로 보존한다.
OCR_ENABLED=true
OCR_COMMAND=tesseract
OCR_LANGUAGES=kor+eng
OCR_TIMEOUT_SEC=60
OCR_MIN_CONFIDENCE=85
PDF_RENDER_COMMAND=pdftoppm
PDF_RENDER_BACKEND=auto
OCR_MAX_RENDER_PIXELS=25000000
# 온통청년 청년정책 Open API 키(youthcenter.go.kr 발급). 비우면 해당 소스 스킵.
YOUTHCENTER_API_KEY=
# Queue policies after API ingestion; validate bounded batches before chatbot use.
POLICY_VALIDATION_BATCH_SIZE=20
POLICY_VALIDATION_INTERVAL_SEC=300

# 일간 스케줄러 (매일 00:10 KST: 마감 공고 삭제 -> 신규 공고 수집·추가)
# 주의: 인스턴스 내부 APScheduler라 리더 선출이 없다. 웹 인스턴스를 2대 이상
# 띄우면 크롤이 중복 실행되므로, 한 대에서만 true로 두고 나머지는 false로 배포한다.
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_HOUR=0
CRAWL_SCHEDULE_MINUTE=10
CRAWL_RETRY_SCHEDULE_ENABLED=true
CRAWL_RETRY_SCHEDULE_INTERVAL_SEC=300
MAP_SYNC_ENABLED=true
STORE_COLLECTION_ENABLED=false
STORE_COLLECTION_INTERVAL_SEC=300
STORE_COLLECTION_REFRESH_HOURS=24
# Explicit official store queries; never automatically publish map pins/benefits.
STORE_COLLECTION_SOURCES_JSON=[]
STORE_PLACE_REVALIDATION_ENABLED=true
STORE_PLACE_REVALIDATION_BATCH_SIZE=10
MAP_SYNC_INTERVAL_SEC=300
# Deterministic issuer adapters; unsupported/changed policy text remains pending.
MAP_AUTO_VALIDATE_ENABLED=true
# Official card source archive; use persistent private storage in production.
CARD_SOURCE_ARCHIVE_DIR=data/card_source_archive
CARD_COLLECTION_ENABLED=true
CARD_COLLECTION_INTERVAL_SEC=300
CARD_COLLECTION_MAX_SOURCES=20
MAP_AUTO_RECHECK_HOURS=24
# 공공데이터포털 인증키. 비워 두면 착한가격업소 수집을 건너뛴다.
DATA_GO_KR_SERVICE_KEY=
GOODPRICE_SYNC_ENABLED=true
GOODPRICE_DISTRICTS=서울특별시 동대문구
MAP_PROMOTION_SOURCES_JSON=[]
MAP_SOURCE_TIMEOUT_SEC=25
MAP_SOURCE_MAX_BYTES=5000000

MAP_OFFICIAL_SOURCES_JSON=[]
KAKAO_REST_API_KEY=
